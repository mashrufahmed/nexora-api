NODE_ENV=development
PORT=5000
API_PREFIX=api/v1


CORS_ORIGINS=

DATABASE_URL=""

REDIS_URL=""

# S3 / MinIO media storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=nexora-media
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=

ADMIN_BOOTSTRAP_TOKEN=""

# Email
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Nexora <no-reply@example.com>"

# OTP
OTP_SECRET=""
OTP_EXPIRES_IN=300
OTP_RESEND_COOLDOWN=60
OTP_MAX_ATTEMPTS=5

SESSION_SECRET=""
SESSION_TTL=900
SESSION_COOKIE_NAME=nexora_admin_sid
ADMIN_PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
ADMIN_PASSWORD_RESET_TTL=900
ADMIN_PASSWORD_RESET_MAX_REQUESTS=3
ADMIN_PASSWORD_RESET_REQUEST_TTL=900


BOOTSTRAP_ADMIN_EMAIL=admin@example.com

ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_ATTEMPT_TTL=900
ADMIN_LOGIN_LOCK_TTL=900